# Environment Variables Example
# Copy this file to .env (or .env.local) and fill in your actual values.
# NEVER commit .env to git!

# =============================================================================
# CLIENT (build-time, inlined into the public browser bundle)
# -----------------------------------------------------------------------------
# IMPORTANT: anything prefixed with VITE_ ends up readable in the shipped JS.
# Never put a bot token, service-role key or API key in a VITE_ variable.
# =============================================================================

# Supabase project URL + public anon (publishable) key.
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Sentry DSN for client error tracking (leave empty to disable).
VITE_SENTRY_DSN=

# Telegram dataset dispatch: only the PUBLIC chat id may live here.
# The bot token is configured by the operator in the in-app vault (localStorage)
# or server-side — see TELEGRAM_DATASET_BOT_TOKEN below.
VITE_TELEGRAM_DATASET_CHAT_ID=

# =============================================================================
# SERVER (Vercel serverless / Supabase Edge — never exposed to the browser)
# =============================================================================

# Supabase service-role key. Required for Telegram WebApp login (it mints the
# real Supabase session) and for server-side database writes.
SERVICE_ROLE=

# Telegram bot token. Required to verify WebApp initData signatures.
TELEGRAM_BOT_TOKEN=

# DeepSeek API key — the only AI provider. Used by /api/deepseek and the
# Supabase Edge Function `deepseek`.
DEEPSEEK_API_KEY=

# Automated Telegram dataset dispatch (server / GitHub Actions cron).
TELEGRAM_DATASET_BOT_TOKEN=
TELEGRAM_DATASET_CHAT_ID=

# -----------------------------------------------------------------------------
# Rate limiting & AI quota (Upstash Redis)
# -----------------------------------------------------------------------------
# REQUIRED in production: without Redis the limiter and the daily quota fall back
# to per-instance memory, which is not reliable on serverless (every cold start
# resets the counters).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Daily AI request allowance per user role.
AI_DAILY_QUOTA_FREE=25
AI_DAILY_QUOTA_ADMIN=500

# When the distributed limiter is unreachable we fail CLOSED in production.
# Set to `true` only to restore the old permissive behaviour (not recommended).
RATE_LIMIT_FAIL_OPEN=false

# -----------------------------------------------------------------------------
# CORS / Telegram session hardening
# -----------------------------------------------------------------------------
# Comma-separated origins allowed to call /api/deepseek from another origin.
# Same-origin calls from the app itself never need this.
ALLOWED_ORIGINS=

# Reject Telegram WebApp initData older than this many seconds (default 86400).
TWA_INIT_DATA_MAX_AGE_SECONDS=86400

# Allow unverified mock Telegram users. Non-production only — ignored in
# production deployments. Set to `false` to disable even locally.
ALLOW_TWA_MOCK=false

# -----------------------------------------------------------------------------
# Superadmin allowlist (optional — built-in defaults apply)
# -----------------------------------------------------------------------------
# Superadmin identities. The server-side role endpoint (api/admin/role.js) only
# accepts a caller whose verified email is listed here, or whose app_metadata
# custom_role is "superadmin". It also needs SERVICE_ROLE to write roles.
SUPERADMIN_EMAIL=
SUPERADMIN_TELEGRAM_IDS=
SUPERADMIN_TELEGRAM_USERNAME=
